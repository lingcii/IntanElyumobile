<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to real files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite clean view URLs (e.g. /download, /dashboard, /auth) to index.php?view=...
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?view=$1 [QSA,L]
</IfModule>
